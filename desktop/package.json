{
  "name": "wechat-data-analysis-desktop",
  "private": true,
  "version": "2.7.1",
  "main": "src/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "dev:gpu": "cross-env WECHAT_TOOL_QWEN_GPU=1 node scripts/dev.cjs",
    "dev:static": "npm --prefix ../frontend run generate && cross-env WECHAT_TOOL_STATIC_UI=1 electron .",
    "build:icon": "node scripts/build-icon.cjs",
    "build:ui": "npm --prefix ../frontend run generate && node scripts/copy-ui.cjs",
    "build:backend": "uv sync --extra build --extra voice-transcription && node scripts/build-backend.cjs",
    "build:backend:gpu": "uv sync --extra build --extra voice-transcription --extra voice-transcription-gpu && node scripts/build-backend.cjs --qwen-gpu",
    "dist": "npm run build:icon && npm run build:ui && npm run build:backend && electron-builder --win --x64 --publish never",
    "dist:fast": "electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "build": {
    "appId": "com.xwechat.app",
    "productName": "xwechat",
    "artifactName": "${productName}-${version}-Setup.${ext}",
    "icon": "src/icon.ico",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "electronFuses": {
      "runAsNode": true
    },
    "files": [
      "src/**/*",
      "!node_modules/ffmpeg-static/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/ui",
        "to": "ui"
      },
      {
        "from": "resources/backend",
        "to": "backend"
      },
      {
        "from": "node_modules/ffmpeg-static",
        "to": "ffmpeg",
        "filter": [
          "ffmpeg",
          "ffmpeg.exe",
          "ffmpeg.LICENSE",
          "ffmpeg.README",
          "ffmpeg.exe.LICENSE",
          "ffmpeg.exe.README",
          "LICENSE"
        ]
      }
    ],
    "win": {
      "icon": "src/icon.ico",
      "forceCodeSigning": false,
      "signExecutable": false,
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.0",
    "png-to-ico": "^3.0.1"
  }
}
